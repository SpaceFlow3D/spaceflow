spaceflow_runtime/
runs/
outputs*/
logs/
lightning_logs/
wandb/
tmp/
debug/
*.log
*.err
*.out
sq_ui/scripts/__TRELLIS_RUNS__/
sq_ui/scripts/__TRELLIS_LOGS__/
